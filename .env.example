# Copy to .env and fill in. Do NOT commit the real .env (it is gitignored).

# --- Core app ---
PORT=3000
URL=http://localhost:3000            # base URL; also used for internal API calls
DATABASE_URL=                        # MongoDB connection string
YEAR=2025                            # current season

# --- Auth0 (express-openid-connect) ---
AUTH_SECRET=                         # long random string; also signs invite tokens
CLIENT_ID=
ISSUER_BASE_URL=

# --- Auth0 Management API (commissioner invite flow) ---
# Only used to write user_metadata when an invite is claimed, so the Machine to
# Machine application backing this needs the `update:users` scope and nothing
# else — the flow never creates Auth0 accounts, it binds whichever identity the
# invitee signed in with. Create it under Auth0 > Applications > APIs >
# Auth0 Management API > Machine to Machine Applications.
# Without these the app runs fine; only claiming an invite fails.
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=

# --- College Football Data API ---
CFBD_API_KEY=

# --- Game-day live scoring poller (modules/live-poll.js) ---
# Opt-in. When 'true', the in-process scheduler runs a poller every 2 min that
# refreshes scores while games are in progress — any day, any season type. It
# only spends a CFBD call when a game is genuinely live and there are calls to
# spare, so standings feel near-live without blowing the monthly budget.
LIVE_POLL_ENABLED=false              # set 'true' to turn the live poller on
# Optional tuning (defaults shown):
# LIVE_POLL_CALL_BUFFER=300          # stop polling once this many CFBD calls remain
# LIVE_POLL_MAX_GAME_HOURS=9         # a kickoff counts as "in progress" for this long
#                                     (governs BOTH the poller and the scoreboard's live/final label)
# CFBD_CALENDAR_TTL_MS=21600000      # calendar cache TTL (modules/cfbd-calendar.js), default 6h

# --- Internal API token ---
# Shared secret that lets the scheduled jobs / scoring modules authenticate to
# the app's own API. MUST be set to the SAME value on the web host AND wherever
# the jobs run, or nightly score updates will fail with 401.
INTERNAL_API_TOKEN=                  # long random string

# --- Email (nodemailer / Gmail) ---
GMAIL_USER=                          # sender Gmail address
GMAIL_APP_PASSWORD=                  # Gmail app password (NOT your account password)
# Scoring jobs email on FAILURE only by default. Set to 'true' to also get a
# report on every successful run (~50/month in season).
# JOB_EMAIL_ON_SUCCESS=false

# --- Cloudinary (profile picture uploads) ---
# Both are PUBLIC (they ship to the browser for unsigned uploads), not secrets.
# The upload preset must be created as "Unsigned" in the Cloudinary console.
CLOUDINARY_CLOUD_NAME=               # e.g. dxxxxxxx (from your Cloudinary dashboard)
CLOUDINARY_UPLOAD_PRESET=            # the unsigned upload preset name
