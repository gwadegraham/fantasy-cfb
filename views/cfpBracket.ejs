<!DOCTYPE html>
<html lang="en" class="cfp-page">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="/styles.css" rel="stylesheet">
    <script src="/haptic.js"></script>
    <script src="/pull-to-refresh.js"></script>
    <link href="/cfpBracket.css" rel="stylesheet">
    <link href="/loading.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Graduate&family=Pacifico&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
    <title>CFP Bracket · Campus Clash</title>
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#101322" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
</head>

<body>
    <%- include('partials/navbar') %>
    <% if (userState) { %>
        <script>
            var userState = <%- userState %>;
        </script>
    <% } %>

    <script>
        var SEASON = '<%= year %>';
        var LEAGUE = '<%= leagueCode %>';
    </script>

    <div id="cfp-bracket" class="cfp-container">
        <div class="cfp-loading">Loading bracket...</div>
    </div>

    <script src="/cfpBracket.js"></script>
</body>

</html>
