<!DOCTYPE html>
<html lang="en" class="gd-page">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <link href="/styles.css" rel="stylesheet">
    <script src="/haptic.js"></script>
    <script src="/pull-to-refresh.js"></script>
    <script src="/fit-names.js"></script>
    <script src="/wp-chart.js"></script>
    <link href="/gameDetail.css" rel="stylesheet">
    <link href="/loading.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Graduate&family=Pacifico&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
    <title>Game Detail · Campus Clash</title>
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#101322" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
</head>

<body>
    <%- include('partials/navbar') %>
    <% if (userState) { %>
        <script>
            var userState = <%- userState %>;
        </script>
    <% } %>

    <div id="game-detail" class="game-detail-container">
        <div class="gd-loading">Loading game data...</div>
    </div>

    <script>
    (function () {
        var GAME_ID = '<%= gameId %>';
        var container = document.getElementById('game-detail');

        function fmt(n) { return n != null ? String(n) : '-'; }
        function pct(n) { return n != null ? n.toFixed(1) + '%' : '-'; }
        // The live strip interpolates CFBD-authored prose (the last play) into
        // innerHTML, so it goes through here first.
        function esc(s) {
            return String(s == null ? '' : s)
                .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
        }
        function timeFmt(secs) {
            if (secs == null) return '-';
            var m = Math.floor(secs / 60);
            var s = secs % 60;
            return m + ':' + String(s).padStart(2, '0');
        }

        async function load() {
            try {
                var res = await fetch('/games/detail/' + GAME_ID);
                if (!res.ok) throw new Error('Game not found');
                var game = await res.json();

                // Fetch logos + colors for both teams (non-fatal if it fails)
                var logoMap = {};
                var colorMap = {};
                var abbrMap = {};
                var mascotMap = {};
                try {
                    var logoRes = await fetch('/teams/teamLogos', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ teams: [game.homeId, game.awayId] })
                    });
                    var logos = await logoRes.json();
                    if (Array.isArray(logos)) {
                        logos.forEach(function (t) {
                            logoMap[t.id] = window.ccLogo ? window.ccLogo(t.logos) : (t.logos && t.logos[0] || '');
                            var c = t.color || '';
                            var ac = t.alt_color || '';
                            colorMap[t.id] = { primary: c ? (c.startsWith('#') ? c : '#' + c) : null, alt: ac ? (ac.startsWith('#') ? ac : '#' + ac) : null, school: t.school };
                            abbrMap[t.id] = t.abbreviation || t.school || '';
                            mascotMap[t.id] = t.mascot || '';
                        });
                    }
                } catch (e) { /* logos are decorative */ }

                render(game, logoMap, colorMap, abbrMap, mascotMap);

                // Logos, colours and abbreviations are fixed for the life of the
                // page, so the refresh below re-renders against these instead of
                // asking /teams/teamLogos again every 30 seconds.
                gdArt = { logoMap: logoMap, colorMap: colorMap, abbrMap: abbrMap, mascotMap: mascotMap };
                gdSchedule(game);
            } catch (err) {
                container.innerHTML = '<div class="gd-error">Could not load game. <a href="/standings">Back to Standings</a></div>';
            }
        }

        // ---- live refresh -------------------------------------------------
        //
        // Same 30s cadence and hidden-tab rule as the league scoreboard. Only
        // this one game is refetched, and only while it is actually in progress
        // — a final or not-yet-kicked-off game arms no timer at all.
        var GD_LIVE_MS = 30000;
        var gdTimer = null;
        var gdArt = null;
        var gdGame = null;

        function gdIsLive(game) {
            if (!game || game.completed) return false;
            if (!game.startDate) return false;
            return Date.parse(game.startDate) <= Date.now();
        }

        function gdSchedule(game) {
            gdGame = game;
            clearTimeout(gdTimer);
            if (!gdIsLive(game) || document.hidden) return;
            gdTimer = setTimeout(gdRefresh, GD_LIVE_MS);
        }

        async function gdRefresh() {
            try {
                var res = await fetch('/games/detail/' + GAME_ID);
                if (!res.ok) throw new Error('refresh failed');
                var game = await res.json();

                // A full re-render replaces the container, which would otherwise
                // drop someone reading the box score back to the top of the
                // page. Sections don't come and go during live play, so putting
                // the scroll position back lands exactly where it was; on the
                // one tick where a game finals and the stat sections appear, it
                // lands close enough.
                var y = window.scrollY;
                render(game, gdArt.logoMap, gdArt.colorMap, gdArt.abbrMap, gdArt.mascotMap);
                window.scrollTo(0, y);

                gdSchedule(game);
            } catch (err) {
                // A missed tick is a stale clock, not a broken page — keep the
                // loop alive so the next one can recover.
                console.error('Live game refresh failed:', err);
                gdTimer = setTimeout(gdRefresh, GD_LIVE_MS);
            }
        }

        document.addEventListener('visibilitychange', function () {
            if (document.hidden) { clearTimeout(gdTimer); return; }
            // Only catch up on a game that is still running — coming back to a
            // final game should cost nothing.
            if (gdArt && gdIsLive(gdGame)) gdRefresh();
        });

        // ---- play-by-play fetch -------------------------------------------
        //
        // The only request on this page that can spend a billable CFBD call
        // (/live/plays is not covered by the /scoreboard quota exemption), so
        // the guards here are the budget, not politeness:
        //
        //   - a final is fetched ONCE. The server stores it on first fetch and
        //     serves every later view from Mongo, so re-asking is pure waste.
        //   - a game that hasn't kicked off is fetched once and left alone; the
        //     server also negative-caches that answer for five minutes.
        //   - nothing is fetched while the tab is hidden, and the live loop
        //     that drives repeats stops on its own at the final.
        //
        // Without those, a forgotten open tab is a real budget event: fifteen
        // games left up for an afternoon is thousands of calls.
        var gdPlaysInFlight = false;

        async function gdFetchPlays(game) {
            if (gdPlaysInFlight || document.hidden) return;

            // A finished game's plays are terminal — one fetch, ever.
            if (gdPlaysDone) return;

            // A game that hasn't kicked off is asked once — that first answer
            // is what tells us there are no plays yet. After it, nothing
            // changes until kickoff, at which point gdIsLive goes true and
            // fetching resumes on its own.
            if (!gdIsLive(game) && !game.completed && gdPlaysStatus != null) return;

            // Also the recursion guard. On the tick where plays first arrive,
            // gdRepaintPlays has to re-render the whole page to place the new
            // section, and render() ends by calling this function again — this
            // flag is still set at that point, so the nested call returns here
            // instead of looping.
            gdPlaysInFlight = true;
            try {
                var res = await fetch('/games/plays/' + GAME_ID);
                if (!res.ok) throw new Error('plays fetch failed: ' + res.status);
                var data = await res.json();

                gdPlays = Array.isArray(data.plays) ? data.plays : [];
                gdDrives = Array.isArray(data.drives) ? data.drives : [];
                gdPlaysStatus = data.status || null;
                gdPlaysLive = data.status === 'live';
                gdSituation = {
                    period: data.period, clock: data.clock,
                    possession: data.possession, down: data.down,
                    distance: data.distance, yardsToGoal: data.yardsToGoal
                };

                // Stop asking once the answer can no longer change. 'db' means
                // the server already has it stored; 'final' means this response
                // is the terminal one and the server has just stored it.
                if (data.source === 'db' || data.status === 'final') gdPlaysDone = true;

                // 'budget' means the server is at its remaining-calls floor.
                // Retrying every tick would just hammer a guard that will keep
                // saying no, so this tab stops asking; a reload after the month
                // rolls over (or after the floor is lowered) starts again.
                if (data.status === 'budget') gdPlaysDone = true;

                gdRepaintPlays();
            } catch (err) {
                // A drive chart that didn't load is not a broken page. The live
                // loop will try again on its next tick; a final game won't,
                // which is the right trade — it'll load on the next visit.
                console.error('Play-by-play fetch failed:', err);
            } finally {
                gdPlaysInFlight = false;
            }
        }

        // Repaint just the play-by-play section. A full re-render would be
        // simpler but would fight the 30s refresh for scroll position, and the
        // plays arrive on their own schedule rather than with the score.
        function gdRepaintPlays() {
            if (!gdArt || !gdTeamCtx) return;
            var container = document.getElementById('game-detail');
            if (!container) return;
            var existing = container.querySelector('#gd-pbp');
            var drives = container.querySelector('.gd-dr-list');
            var field = container.querySelector('.gd-lf-section');
            // Every section this fetch feeds has to already be on the page for
            // an in-place swap to be enough. If the field or the drive chart is
            // missing — first arrival, or a game that just went live — fall
            // through to the full re-render that places them.
            var needsField = gdPlaysLive && !field;
            if (existing && drives && !needsField) {
                // Swap the lists in place so a reader keeps their scroll
                // position, their chosen tab, and their open quarters.
                var list = existing.querySelector('.gd-pbp-list');
                if (list) list.innerHTML = gdPlayList(gdTeamCtx);
                drives.innerHTML = gdDriveRows(gdTeamCtx);
                if (field && !gdFieldUpdate(field, gdTeamCtx)) {
                    // Nothing left to show — the game just went final.
                    field.remove();
                }
                return;
            }
            // First arrival — the section didn't exist at last paint, so the
            // page has to be rebuilt to place it.
            render(gdGame, gdArt.logoMap, gdArt.colorMap, gdArt.abbrMap, gdArt.mascotMap);
        }

        // Ensure a hex color is bright enough for bar fills on a dark background.
        // Returns the color lightened to at least minLum relative luminance.
        function ensureBarContrast(hex) {
            if (!hex || hex.indexOf('#') !== 0) return hex;
            var r = parseInt(hex.slice(1, 3), 16);
            var g = parseInt(hex.slice(3, 5), 16);
            var b = parseInt(hex.slice(5, 7), 16);
            var lum = (0.299 * r + 0.587 * g + 0.114 * b) / 255;
            if (lum >= 0.3) return hex;
            // Blend toward white until brightness reaches 0.3
            var t = (0.3 - lum) / (1 - lum);
            var nr = Math.round(r + (255 - r) * t);
            var ng = Math.round(g + (255 - g) * t);
            var nb = Math.round(b + (255 - b) * t);
            return '#' + ((1 << 24) + (nr << 16) + (ng << 8) + nb).toString(16).slice(1);
        }

        function render(game, logos, colors, abbrs, mascots) {
            var homeLogo = logos[game.homeId] || '';
            var awayLogo = logos[game.awayId] || '';
            var homeColor = (colors[game.homeId] && colors[game.homeId].primary) || 'var(--cc-interactive)';
            var awayColor = (colors[game.awayId] && colors[game.awayId].primary) || 'var(--cc-interactive)';
            var homeAbbr = abbrs[game.homeId] || game.homeTeam;
            var awayAbbr = abbrs[game.awayId] || game.awayTeam;

            // Per-side render context, shared by the play-by-play cards and the
            // player stat tables further down. Defined here rather than beside
            // its first use because both consumers need it and the play-by-play
            // section renders earlier in the page.
            var teamCtx = {
                away: { id: game.awayId, name: game.awayTeam, abbr: awayAbbr, logo: awayLogo, color: awayColor },
                home: { id: game.homeId, name: game.homeTeam, abbr: homeAbbr, logo: homeLogo, color: homeColor }
            };
            gdTeamCtx = teamCtx;
            var homeWon = game.homePoints > game.awayPoints;
            var awayWon = game.awayPoints > game.homePoints;
            var isFinal = game.completed;
            var isLive = !isFinal && game.period;

            // Game date
            var dateStr = '';
            if (game.startDate) {
                var d = new Date(game.startDate);
                dateStr = d.toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
            }

            // Status label
            var statusLabel = '';
            if (isFinal) {
                statusLabel = '<span class="gd-status gd-final">Final</span>';
            } else if (isLive) {
                var clockStr = game.clock ? ' · ' + game.clock : '';
                statusLabel = '<span class="gd-status gd-live">Q' + game.period + clockStr + '</span>';
            } else {
                var timeStr = 'Scheduled';
                if (game.startDate && !game.startTimeTbd) {
                    var dt = new Date(game.startDate);
                    timeStr = dt.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' });
                }
                statusLabel = '<span class="gd-status gd-scheduled">' + timeStr + '</span>';
            }

            var html = '';

            // ---- Back link ----
            html += '<a href="javascript:history.back()" class="gd-back"><i class="fas fa-arrow-left"></i> Back</a>';

            // ---- Header: matchup ----
            var gradStyle = 'background: linear-gradient(90deg, ' + awayColor + '38 0%, transparent 38%, transparent 62%, ' + homeColor + '38 100%);';
            html += '<div class="gd-header" style="' + gradStyle + '">';
            html += '<div class="gd-date">' + dateStr + '</div>';
            html += statusLabel;
            var awayRankStr = game.awayRanking ? '<span class="gd-rank">' + game.awayRanking + '</span> ' : '';
            var homeRankStr = game.homeRanking ? '<span class="gd-rank">' + game.homeRanking + '</span> ' : '';
            var awayScoreStr = game.awayPoints != null ? String(game.awayPoints) : '';
            var homeScoreStr = game.homePoints != null ? String(game.homePoints) : '';
            var awayRecord = game.awayRecord || '';
            var homeRecord = game.homeRecord || '';

            var hasScores = game.awayPoints != null || game.homePoints != null;

            // Who has the ball. CFBD reports possession as the SIDE ('home' /
            // 'away'), not a team name — comparing it against a school name (as
            // every surface used to) is never true. A name match stays as a
            // fallback in case a future payload sends one. Live games only: the
            // field lingers on a final until the next poll clears it.
            var possSide = String(game.possession || '').toLowerCase();
            var awayBall = isLive && (possSide === 'away' || game.possession === game.awayTeam);
            var homeBall = isLive && (possSide === 'home' || game.possession === game.homeTeam);
            var ballIcon = ' <i class="fa-solid fa-football gd-poss" aria-label="Has possession"></i>';

            if (hasScores) {
                // 5-column grid: logo | score/record | status | score/record | logo
                html += '<div class="gd-matchup-grid">';

                // Row 1: logo | score | Final/Qn | score | logo
                html += '<a href="/team?team=' + game.awayId + '" class="gd-mu-logo"><img class="gd-logo" src="' + awayLogo + '" alt="" /></a>';
                html += '<div class="gd-mu-score' + (awayWon ? ' gd-winner' : '') + '">' + awayScoreStr + '</div>';
                // Always the matchup separator, never the period: the status pill
                // above already carries "Q4 · 3:12", and a live game was the one
                // state where this cell repeated it a few pixels away.
                html += '<div class="gd-mu-center">@</div>';
                html += '<div class="gd-mu-score' + (homeWon ? ' gd-winner' : '') + '">' + homeScoreStr + '</div>';
                html += '<a href="/team?team=' + game.homeId + '" class="gd-mu-logo"><img class="gd-logo" src="' + homeLogo + '" alt="" /></a>';

                // Row 2: name | record | · | record | name
                html += '<a href="/team?team=' + game.awayId + '" class="gd-mu-name"><span class="gd-tnm-full">' + awayRankStr + game.awayTeam + (awayBall ? ballIcon : '') + '</span><span class="gd-tnm-abbr">' + awayRankStr + awayAbbr + (awayBall ? ballIcon : '') + '</span></a>';
                html += '<div class="gd-mu-record">' + awayRecord + '</div>';
                html += '<div class="gd-mu-sub-center"></div>';
                html += '<div class="gd-mu-record">' + homeRecord + '</div>';
                html += '<a href="/team?team=' + game.homeId + '" class="gd-mu-name"><span class="gd-tnm-full">' + homeRankStr + game.homeTeam + (homeBall ? ballIcon : '') + '</span><span class="gd-tnm-abbr">' + homeRankStr + homeAbbr + (homeBall ? ballIcon : '') + '</span></a>';

                html += '</div>';
            } else {
                // Pre-game: compact row — logo | name (record) | @ | name (record) | logo
                html += '<div class="gd-matchup-pre">';
                html += '<a href="/team?team=' + game.awayId + '" class="gd-mu-logo"><img class="gd-logo" src="' + awayLogo + '" alt="" /></a>';
                html += '<div class="gd-mu-pre-team">';
                html += '<a href="/team?team=' + game.awayId + '" class="gd-mu-name"><span class="gd-tnm-full">' + awayRankStr + game.awayTeam + '</span><span class="gd-tnm-abbr">' + awayRankStr + awayAbbr + '</span></a>';
                if (awayRecord) html += '<div class="gd-mu-record">' + awayRecord + '</div>';
                html += '</div>';
                html += '<div class="gd-mu-at">@</div>';
                html += '<div class="gd-mu-pre-team">';
                html += '<a href="/team?team=' + game.homeId + '" class="gd-mu-name"><span class="gd-tnm-full">' + homeRankStr + game.homeTeam + '</span><span class="gd-tnm-abbr">' + homeRankStr + homeAbbr + '</span></a>';
                if (homeRecord) html += '<div class="gd-mu-record">' + homeRecord + '</div>';
                html += '</div>';
                html += '<a href="/team?team=' + game.homeId + '" class="gd-mu-logo"><img class="gd-logo" src="' + homeLogo + '" alt="" /></a>';
                html += '</div>';
            }
            html += '</div>'; // .gd-header

            // ---- Live strip: down & distance, possession, last play ----
            // This page has the most room of any surface that shows a live game,
            // so it gets the fullest treatment: the situation and who has the
            // ball on one line, the last play spelled out underneath.
            //
            // Both fields come free with the scoreboard poll and are nulled when
            // a game finals — in modules/scoreboard.js and again in the
            // /games/week/mass-create upsert. `completed` is still checked here
            // rather than trusting the fields to be empty: it is the one flag
            // every ingest path agrees on, and a stale "3rd & 7" sitting under a
            // final score is a worse failure than showing nothing.
            //
            // While the game is in progress the strip is held back and placed
            // under the box score instead — see the live assembly below.
            var liveStripHtml = '';
            if (!isFinal && (game.situation || game.lastPlay)) {
                liveStripHtml += '<div class="gd-section gd-livestrip">';
                if (game.situation) liveStripHtml += '<div class="gd-ls-head"><span class="gd-ls-situation">' + esc(game.situation) + '</span></div>';
                if (game.lastPlay) liveStripHtml += '<div class="gd-ls-play">' + esc(game.lastPlay) + '</div>';
                liveStripHtml += '</div>';
            }
            if (!isLive) html += liveStripHtml;

            // ---- Meta row: venue, weather, broadcast, attendance ----
            // Each part is wrapped so it forms a SINGLE flex item in .gd-meta.
            // Unwrapped, an icon and its label are separate flex items and the
            // row's flex-wrap could break between them — leaving the broadcast
            // icon stranded at the end of one line and "ESPN" on the next.
            var metaParts = [];
            function metaItem(inner) {
                return '<span class="gd-meta-item">' + inner + '</span>';
            }
            if (game.venue) metaParts.push(metaItem('<i class="fas fa-location-dot"></i> ' + game.venue));
            if (game.weather) {
                var wxEmoji = game.weather.emoji && window.ccWeatherEmoji ? window.ccWeatherEmoji[game.weather.emoji] || '' : '';
                var wxParts = [];
                if (game.weather.condition) wxParts.push(game.weather.condition);
                if (game.weather.temp != null) wxParts.push(game.weather.temp + '°F');
                if (game.weather.wind != null) wxParts.push('Wind ' + game.weather.wind + ' mph');
                if (wxParts.length) metaParts.push(metaItem(wxEmoji + ' ' + wxParts.join(' · ')));
            }
            if (game.outlet) metaParts.push(metaItem((window.ccIcon ? window.ccIcon('broadcast', { size: 14 }) : '') + ' ' + game.outlet));
            if (game.attendance) metaParts.push(metaItem('<i class="fas fa-users"></i> ' + Number(game.attendance).toLocaleString()));
            if (metaParts.length) {
                html += '<div class="gd-meta">' + metaParts.join('<span class="gd-meta-sep"></span>') + '</div>';
            }

            // ---- Matchup Predictor (football field) ----
            var homeWP = null;
            if (game.pregameWinProb != null) {
                homeWP = game.pregameWinProb * 100;
            } else if (game.homePregameElo != null && game.awayPregameElo != null) {
                homeWP = 100 / (1 + Math.pow(10, -(game.homePregameElo - game.awayPregameElo) / 400));
            }
            // Once the game is in progress the field gives way to the curve the
            // game has actually traced (public/wp-chart.js). It returns '' when
            // there aren't yet two points to draw a line between — the first
            // minutes of a game, or a game that predates the snapshot series —
            // and the predictor stands in until there are.
            //
            // Built for finals too, but placed further down the page — see the
            // "Win probability (final games)" block below. During play it is a
            // prediction and belongs up here; afterwards it is history, and
            // reads better under the box score than above it.
            var wpChartHtml = '';
            if (window.ccWpChart && (isLive || isFinal)) {
                wpChartHtml = ccWpChart.render(game, {
                    homeTeam: game.homeTeam, awayTeam: game.awayTeam,
                    homeAbbr: homeAbbr, awayAbbr: awayAbbr,
                    homeLogo: homeLogo, awayLogo: awayLogo,
                    homeColor: ensureBarContrast(homeColor),
                    awayColor: ensureBarContrast(awayColor)
                });
            }

            var wpSectionHtml = '';
            if (isLive && wpChartHtml) {
                wpSectionHtml += wpChartHtml;
            } else if (homeWP != null && !isFinal) {
                var awayWP = 100 - homeWP;

                wpSectionHtml += '<div class="gd-section gd-predictor">';
                wpSectionHtml += '<h3 class="gd-section-title"><i class="fas fa-football"></i> Matchup Predictor</h3>';
                wpSectionHtml += '<div class="gd-field" style="--wp:' + (homeWP / 100) + '">';

                // End zones
                var awayEZ = (mascots && mascots[game.awayId]) || awayAbbr;
                var homeEZ = (mascots && mascots[game.homeId]) || homeAbbr;
                wpSectionHtml += '<div class="gd-field-ez gd-field-ez-away" style="background:' + awayColor + '"><span>' + awayEZ + '</span></div>';
                wpSectionHtml += '<div class="gd-field-ez gd-field-ez-home" style="background:' + homeColor + '"><span>' + homeEZ + '</span></div>';

                // Yard lines
                wpSectionHtml += '<div class="gd-field-lines">';
                for (var yl = 0; yl < 9; yl++) wpSectionHtml += '<div class="gd-field-yl' + (yl === 4 ? ' gd-field-yl-mid' : '') + '"></div>';
                wpSectionHtml += '</div>';

                // Ball marker at home win prob position (away end = 0%, home end = 100%)
                wpSectionHtml += '<div class="gd-field-marker"></div>';
                wpSectionHtml += '<div class="gd-field-ball">🏈</div>';

                wpSectionHtml += '</div>'; // .gd-field

                // Probability labels
                wpSectionHtml += '<div class="gd-field-probs">';
                wpSectionHtml += '<div class="gd-field-prob">';
                wpSectionHtml += '<img src="' + awayLogo + '" alt="" />';
                wpSectionHtml += '<div><div class="gd-field-pct">' + awayWP.toFixed(1) + '%</div>';
                wpSectionHtml += '<div class="gd-field-name">' + game.awayTeam + '</div></div>';
                wpSectionHtml += '</div>';
                wpSectionHtml += '<div class="gd-field-prob gd-field-prob-right">';
                wpSectionHtml += '<div><div class="gd-field-pct">' + homeWP.toFixed(1) + '%</div>';
                wpSectionHtml += '<div class="gd-field-name">' + game.homeTeam + '</div></div>';
                wpSectionHtml += '<img src="' + homeLogo + '" alt="" />';
                wpSectionHtml += '</div>';
                wpSectionHtml += '</div>';

                wpSectionHtml += '</div>'; // .gd-predictor
            }
            if (!isLive) html += wpSectionHtml;

            // ---- Season Averages (tug-of-war bars, pre-game only) ----
            var preGameStatsHtml = '';
            if (game.seasonStats && !isFinal) {
                var hss = game.seasonStats.home;
                var ass = game.seasonStats.away;
                if (hss && ass && hss.games > 0 && ass.games > 0) {
                    var hs_ = hss.stats || {};
                    var as_ = ass.stats || {};
                    // Scoring is the one row that can't come from `stats` — CFBD's
                    // season aggregate has no points field at all — so the server
                    // sums it off the games, and it brings its own games count.
                    var ppg = function (side, key) {
                        var sc = side && side.scoring;
                        return (sc && sc.games) ? sc[key] / sc.games : 0;
                    };
                    var hg = hss.games;
                    var ag = ass.games;

                    var ssRows = [
                        { label: 'Total YPG', away: (as_.totalYards || 0) / ag, home: (hs_.totalYards || 0) / hg },
                        { label: 'Yards allowed / game', away: (as_.totalYardsOpponent || 0) / ag, home: (hs_.totalYardsOpponent || 0) / hg, invert: true },
                        { label: 'Rush YPG', away: (as_.rushingYards || 0) / ag, home: (hs_.rushingYards || 0) / hg },
                        { label: 'Pass YPG', away: (as_.netPassingYards || 0) / ag, home: (hs_.netPassingYards || 0) / hg },
                        { label: 'Points / game', away: ppg(ass, 'pointsFor'), home: ppg(hss, 'pointsFor') },
                        { label: 'Points allowed / game', away: ppg(ass, 'pointsAgainst'), home: ppg(hss, 'pointsAgainst'), invert: true },
                        { label: 'Turnovers / game', away: (as_.turnovers || 0) / ag, home: (hs_.turnovers || 0) / hg, invert: true },
                        { label: 'Sacks / game', away: (as_.sacks || 0) / ag, home: (hs_.sacks || 0) / hg },
                        { label: '3rd down %', away: (as_.thirdDowns > 0 ? (as_.thirdDownConversions || 0) / as_.thirdDowns * 100 : 0), home: (hs_.thirdDowns > 0 ? (hs_.thirdDownConversions || 0) / hs_.thirdDowns * 100 : 0), isPct: true }
                    ];

                    var awayBarColor = ensureBarContrast(awayColor);
                    var homeBarColor = ensureBarContrast(homeColor);

                    preGameStatsHtml += '<div class="gd-section">';
                    preGameStatsHtml += '<div class="gd-ss-header">';
                    preGameStatsHtml += '<div class="gd-ss-team-label"><img src="' + awayLogo + '" alt="" /><span>' + awayAbbr + '</span></div>';
                    preGameStatsHtml += '<h3 class="gd-section-title"><i class="fas fa-chart-simple"></i> Season Averages</h3>';
                    preGameStatsHtml += '<div class="gd-ss-team-label" style="flex-direction:row-reverse"><img src="' + homeLogo + '" alt="" /><span>' + homeAbbr + '</span></div>';
                    preGameStatsHtml += '</div>';

                    for (var si = 0; si < ssRows.length; si++) {
                        var sr = ssRows[si];
                        var aVal = sr.away;
                        var hVal = sr.home;
                        var total = aVal + hVal;
                        var awayPctBar = total > 0 ? (aVal / total * 100) : 50;

                        var aDisp = sr.isPct ? aVal.toFixed(1) + '%' : aVal.toFixed(1);
                        var hDisp = sr.isPct ? hVal.toFixed(1) + '%' : hVal.toFixed(1);

                        // Which team is winning the row. The bar cannot say it:
                        // its length is proportional to the NUMBER, so on an
                        // "allowed" row the team that gave up more gets the
                        // longer bar and the glance reads backwards. `invert`
                        // says which direction wins — it was computed here and
                        // thrown away until a marker existed to use it. Neither
                        // side is marked on a tie.
                        var aLead = sr.invert ? aVal < hVal : aVal > hVal;
                        var hLead = sr.invert ? hVal < aVal : hVal > aVal;

                        var caret = function (win, color, glyph) {
                            return '<span class="gd-ss-caret" aria-hidden="true" style="color:' + color
                                + (win ? '' : ';visibility:hidden') + '">' + glyph + '</span>';
                        };

                        preGameStatsHtml += '<div class="gd-ss-row">';
                        preGameStatsHtml += '<div class="gd-ss-label">'
                            + caret(aLead, awayBarColor, '\u25c0')
                            + '<span>' + sr.label + '</span>'
                            + caret(hLead, homeBarColor, '\u25b6')
                            + '</div>';
                        preGameStatsHtml += '<div class="gd-ss-track">';
                        preGameStatsHtml += '<div class="gd-ss-fill gd-ss-fill-away" style="width:' + awayPctBar + '%;background:' + awayBarColor + '">' + aDisp + '</div>';
                        preGameStatsHtml += '<div class="gd-ss-fill gd-ss-fill-home" style="width:' + (100 - awayPctBar) + '%;background:' + homeBarColor + '">' + hDisp + '</div>';
                        preGameStatsHtml += '</div></div>';
                    }

                    preGameStatsHtml += '</div>'; // .gd-section
                }
            }

            // ---- Player Season Leaders (pre-game only) ----
            if (game.playerLeaders && !isFinal) {
                var hpl = game.playerLeaders.home;
                var apl = game.playerLeaders.away;
                if (hpl || apl) {
                    var plCats = [
                        { key: 'passing', label: 'Passing', stat: 'YDS', unit: 'yds' },
                        { key: 'rushing', label: 'Rushing', stat: 'YDS', unit: 'yds' },
                        { key: 'receiving', label: 'Receiving', stat: 'YDS', unit: 'yds' },
                        { key: 'tackles', label: 'Tackles', stat: 'TOT', unit: '' },
                        { key: 'sacks', label: 'Sacks', stat: 'SACKS', unit: '' },
                        { key: 'interceptions', label: 'Interceptions', stat: 'INT', unit: '' },
                        { key: 'kicking', label: 'Kicking', stat: 'PTS', unit: 'pts' }
                    ];

                    preGameStatsHtml += '<div class="gd-section">';
                    preGameStatsHtml += '<div class="gd-ss-header">';
                    preGameStatsHtml += '<div class="gd-ss-team-label"><img src="' + awayLogo + '" alt="" /><span>' + awayAbbr + '</span></div>';
                    preGameStatsHtml += '<h3 class="gd-section-title"><i class="fas fa-user-shield"></i> Season Leaders</h3>';
                    preGameStatsHtml += '<div class="gd-ss-team-label" style="flex-direction:row-reverse"><img src="' + homeLogo + '" alt="" /><span>' + homeAbbr + '</span></div>';
                    preGameStatsHtml += '</div>';

                    for (var pli = 0; pli < plCats.length; pli++) {
                        var pc = plCats[pli];
                        var aLeader = apl && apl[pc.key] && apl[pc.key][0] ? apl[pc.key][0] : null;
                        var hLeader = hpl && hpl[pc.key] && hpl[pc.key][0] ? hpl[pc.key][0] : null;
                        if (!aLeader && !hLeader) continue;

                        var aName = aLeader ? aLeader.name : '—';
                        var aPos = aLeader && aLeader.pos ? aLeader.pos : '';
                        var hName = hLeader ? hLeader.name : '—';
                        var hPos = hLeader && hLeader.pos ? hLeader.pos : '';

                        // No leader means no data, NOT a zero. Rendering "0 yds"
                        // beside the dash claimed a team whose stats simply
                        // haven't been ingested yet had a 0-yard leader.
                        var aStat = aLeader
                            ? (aLeader[pc.stat] || 0) + (pc.unit ? ' ' + pc.unit : '')
                            : '';
                        var hStat = hLeader
                            ? (hLeader[pc.stat] || 0) + (pc.unit ? ' ' + pc.unit : '')
                            : '';

                        preGameStatsHtml += '<div class="gd-pl-row">';
                        preGameStatsHtml += '<div class="gd-pl-player gd-pl-away">';
                        preGameStatsHtml += '<span class="gd-pl-name">' + aName + '</span>';
                        if (aPos) preGameStatsHtml += '<span class="gd-pl-pos">' + aPos + '</span>';
                        if (aStat) preGameStatsHtml += '<span class="gd-pl-stat">' + aStat + '</span>';
                        preGameStatsHtml += '</div>';
                        preGameStatsHtml += '<div class="gd-pl-cat">' + pc.label + '</div>';
                        preGameStatsHtml += '<div class="gd-pl-player gd-pl-home">';
                        if (hStat) preGameStatsHtml += '<span class="gd-pl-stat">' + hStat + '</span>';
                        if (hPos) preGameStatsHtml += '<span class="gd-pl-pos">' + hPos + '</span>';
                        preGameStatsHtml += '<span class="gd-pl-name">' + hName + '</span>';
                        preGameStatsHtml += '</div>';
                        preGameStatsHtml += '</div>';
                    }

                    preGameStatsHtml += '</div>'; // .gd-section
                }
            }
            if (!isLive) html += preGameStatsHtml;

            // ---- Betting lines (odds table) ----
            var oddsHtml = '';
            if (game.bettingLines) {
                var bl = game.bettingLines;
                var homeSpread = bl.spread;
                var awaySpread = homeSpread != null ? -homeSpread : null;
                var hasSpread = homeSpread != null;
                var hasOU = bl.overUnder != null;
                var hasML = bl.homeMoneyline != null || bl.awayMoneyline != null;
                var hasOpen = bl.spreadOpen != null || bl.overUnderOpen != null;

                oddsHtml += '<div class="gd-section gd-betting">';
                oddsHtml += '<div class="gd-odds-header">';
                oddsHtml += '<h3 class="gd-section-title"><i class="fas fa-chart-line"></i> Game Odds</h3>';
                if (bl.provider) oddsHtml += '<span class="gd-odds-provider">' + bl.provider + '</span>';
                oddsHtml += '</div>';

                oddsHtml += '<table class="gd-odds-table"><thead><tr><th></th>';
                if (hasOpen) oddsHtml += '<th>Open</th>';
                if (hasSpread) oddsHtml += '<th>Spread</th>';
                if (hasOU) oddsHtml += '<th>Total</th>';
                if (hasML) oddsHtml += '<th>ML</th>';
                oddsHtml += '</tr></thead><tbody>';

                // Away team row
                oddsHtml += '<tr>';
                oddsHtml += '<td><div class="gd-odds-team"><img src="' + awayLogo + '" class="gd-odds-logo" /><span>' + awayAbbr + '</span></div></td>';
                if (hasOpen) {
                    var awayOpen = bl.overUnderOpen != null ? 'o' + bl.overUnderOpen : (bl.spreadOpen != null ? ((-bl.spreadOpen) > 0 ? '+' : '') + (-bl.spreadOpen) : '—');
                    oddsHtml += '<td>' + awayOpen + '</td>';
                }
                if (hasSpread) {
                    var asFmt = awaySpread > 0 ? '+' + awaySpread : '' + awaySpread;
                    oddsHtml += '<td><span class="gd-odds-hl">' + asFmt + '</span></td>';
                }
                if (hasOU) {
                    oddsHtml += '<td><span class="gd-odds-hl">o' + bl.overUnder + '</span></td>';
                }
                if (hasML) {
                    oddsHtml += '<td>' + (bl.awayMoneyline != null ? (bl.awayMoneyline > 0 ? '+' : '') + bl.awayMoneyline : '—') + '</td>';
                }
                oddsHtml += '</tr>';

                // Home team row
                oddsHtml += '<tr>';
                oddsHtml += '<td><div class="gd-odds-team"><img src="' + homeLogo + '" class="gd-odds-logo" /><span>' + homeAbbr + '</span></div></td>';
                if (hasOpen) {
                    var homeOpen = bl.spreadOpen != null ? (bl.spreadOpen > 0 ? '+' : '') + bl.spreadOpen : '—';
                    oddsHtml += '<td>' + homeOpen + '</td>';
                }
                if (hasSpread) {
                    var hsFmt = homeSpread > 0 ? '+' + homeSpread : '' + homeSpread;
                    oddsHtml += '<td><span class="gd-odds-hl">' + hsFmt + '</span></td>';
                }
                if (hasOU) {
                    oddsHtml += '<td><span class="gd-odds-hl">u' + bl.overUnder + '</span></td>';
                }
                if (hasML) {
                    oddsHtml += '<td>' + (bl.homeMoneyline != null ? (bl.homeMoneyline > 0 ? '+' : '') + bl.homeMoneyline : '—') + '</td>';
                }
                oddsHtml += '</tr>';

                oddsHtml += '</tbody></table></div>';
            }
            if (!isFinal && !isLive) html += oddsHtml;

            // ---- Score by quarter ----
            var lineScoreHtml = '';
            var homeLS = game.homeLineScores || [];
            var awayLS = game.awayLineScores || [];
            var maxQ = Math.max(homeLS.length, awayLS.length, 4);
            if (homeLS.length || awayLS.length) {
                lineScoreHtml += '<div class="gd-section">';
                lineScoreHtml += '<div class="gd-table-scroll"><table class="gd-linescore">';
                lineScoreHtml += '<thead><tr><th></th>';
                for (var q = 0; q < maxQ; q++) {
                    lineScoreHtml += '<th>' + (q < 4 ? 'Q' + (q + 1) : 'OT' + (q > 4 ? q - 3 : '')) + '</th>';
                }
                lineScoreHtml += '<th class="gd-total">T</th></tr></thead><tbody>';

                // Away
                lineScoreHtml += '<tr class="' + (awayWon ? 'gd-row-winner' : '') + '">';
                lineScoreHtml += '<td class="gd-ls-team"><img src="' + awayLogo + '" class="gd-ls-logo" /><span class="gd-ls-full">' + game.awayTeam + '</span><span class="gd-ls-abbr">' + awayAbbr + '</span></td>';
                for (var q = 0; q < maxQ; q++) lineScoreHtml += '<td>' + (awayLS[q] != null ? awayLS[q] : '-') + '</td>';
                lineScoreHtml += '<td class="gd-total">' + fmt(game.awayPoints) + '</td></tr>';

                // Home
                lineScoreHtml += '<tr class="' + (homeWon ? 'gd-row-winner' : '') + '">';
                lineScoreHtml += '<td class="gd-ls-team"><img src="' + homeLogo + '" class="gd-ls-logo" /><span class="gd-ls-full">' + game.homeTeam + '</span><span class="gd-ls-abbr">' + homeAbbr + '</span></td>';
                for (var q = 0; q < maxQ; q++) lineScoreHtml += '<td>' + (homeLS[q] != null ? homeLS[q] : '-') + '</td>';
                lineScoreHtml += '<td class="gd-total">' + fmt(game.homePoints) + '</td></tr>';

                lineScoreHtml += '</tbody></table></div>';
                lineScoreHtml += '</div>';
            }
            // Live games get the mobile-first running order: hero, venue/weather,
            // box score, last play, win probability, odds — then the pre-game
            // season context, which matters least once the game is under way.
            // Everything above deferred its markup into a variable to make this
            // one ordering decision, rather than scattering it through the page.
            if (isLive) {
                html += lineScoreHtml;
                html += liveStripHtml;
                html += wpSectionHtml;
                html += oddsHtml;
                html += preGameStatsHtml;
            } else {
                html += lineScoreHtml;
            }


            // ---- Play-by-play ----
            // Sits right after the linescore, which is where it reads best:
            // score, then how the score happened. Its data comes from a
            // SEPARATE endpoint (/games/plays/:id) to the rest of this page,
            // because that one can cost a billable CFBD call — see
            // modules/live-plays.js. So it renders from whatever gdPlays holds
            // and is filled in asynchronously; on first paint it shows nothing
            // rather than blocking the page on a network round trip.
            html += gdFieldGraphic(teamCtx);
            html += renderPlaysSection(teamCtx);
            html += renderDrivesSection(teamCtx);

            // ---- Team stats comparison ----
            var hs = (game.teamStats && game.teamStats.home) || {};
            var as = (game.teamStats && game.teamStats.away) || {};
            if (Object.keys(hs).length || Object.keys(as).length) {
                html += '<div class="gd-section">';
                html += '<h3 class="gd-section-title">Team Stats</h3>';
                html += '<div class="gd-stats-grid">';

                var statRows = [
                    ['Total Yards', fmt(as.totalYards), fmt(hs.totalYards)],
                    ['Passing Yards', fmt(as.netPassingYards), fmt(hs.netPassingYards)],
                    ['Rushing Yards', fmt(as.rushingYards), fmt(hs.rushingYards)],
                    ['Passing TDs', fmt(as.passingTDs), fmt(hs.passingTDs)],
                    ['Rushing TDs', fmt(as.rushingTDs), fmt(hs.rushingTDs)],
                    ['Turnovers', fmt(as.turnovers), fmt(hs.turnovers)],
                    ['Sacks', fmt(as.sacks), fmt(hs.sacks)],
                    ['TFL', fmt(as.tacklesForLoss), fmt(hs.tacklesForLoss)],
                    ['Penalties', fmt(as.penalties), fmt(hs.penalties)],
                    ['3rd Down %', pct(as.thirdDownPct), pct(hs.thirdDownPct)],
                    ['4th Down %', pct(as.fourthDownPct), pct(hs.fourthDownPct)],
                    ['Possession', timeFmt(as.possessionSeconds), timeFmt(hs.possessionSeconds)],
                ];

                for (var i = 0; i < statRows.length; i++) {
                    var row = statRows[i];
                    var awayVal = parseFloat(row[1]) || 0;
                    var homeVal = parseFloat(row[2]) || 0;
                    var total = awayVal + homeVal;
                    var awayPct = total > 0 ? (awayVal / total * 100) : 50;
                    // Turnovers/penalties: lower is better
                    var invertBar = row[0] === 'Turnovers' || row[0] === 'Penalties';
                    var awayLead = invertBar ? awayVal < homeVal : awayVal > homeVal;
                    var homeLead = invertBar ? homeVal < awayVal : homeVal > awayVal;

                    html += '<div class="gd-stat-row">';
                    html += '<div class="gd-stat-val' + (awayLead ? ' gd-stat-lead' : '') + '">' + row[1] + '</div>';
                    html += '<div class="gd-stat-center">';
                    html += '<div class="gd-stat-label">' + row[0] + '</div>';
                    html += '<div class="gd-stat-bar"><div class="gd-stat-bar-fill" style="width:' + awayPct + '%;background:' + awayColor + '"></div><div class="gd-stat-bar-fill gd-stat-bar-right" style="width:' + (100 - awayPct) + '%;background:' + homeColor + '"></div></div>';
                    html += '</div>';
                    html += '<div class="gd-stat-val' + (homeLead ? ' gd-stat-lead' : '') + '">' + row[2] + '</div>';
                    html += '</div>';
                }

                html += '</div></div>'; // .gd-stats-grid, .gd-section
            }

            // ---- Win probability (final games) ----
            // The series survives the completion cleanup that nulls every other
            // live field, and the poller closes it with a terminal 1/0 built
            // from the final score — so the whole arc of a finished game is
            // still here to read back. Empty for anything that finished before
            // the snapshots existed, which is every game before Sep 2026.
            if (isFinal && wpChartHtml) html += wpChartHtml;

            // ---- Player stats ----
            var hp = (game.playerStats && game.playerStats.home) || {};
            var ap = (game.playerStats && game.playerStats.away) || {};
            if (Object.keys(hp).length || Object.keys(ap).length) {
                html += renderPlayerSection('Passing', ap.passing, hp.passing,
                    ['C/ATT', 'YDS', 'TD', 'INT', 'QBR'],
                    function (p) { return [p.c + '/' + p.att, p.yds, p.td, p.int, p.qbr != null ? p.qbr.toFixed(1) : '-']; }, teamCtx);

                html += renderPlayerSection('Rushing', ap.rushing, hp.rushing,
                    ['CAR', 'YDS', 'TD', 'LNG'],
                    function (p) { return [p.car, p.yds, p.td, p.lng]; }, teamCtx);

                html += renderPlayerSection('Receiving', ap.receiving, hp.receiving,
                    ['REC', 'YDS', 'TD', 'LNG'],
                    function (p) { return [p.rec, p.yds, p.td, p.lng]; }, teamCtx);

                html += renderPlayerSection('Defensive', ap.defensive, hp.defensive,
                    ['TOT', 'SOLO', 'TFL', 'SACKS', 'INT'],
                    function (p) { return [p.tot, p.solo, p.tfl, p.sacks, p.int]; }, teamCtx);

                if ((ap.kicking && ap.kicking.length) || (hp.kicking && hp.kicking.length)) {
                    html += renderPlayerSection('Kicking', ap.kicking, hp.kicking,
                        ['FG', 'PCT', 'LNG', 'XP', 'PTS'],
                        function (p) { return [p.fgm + '/' + p.fga, p.pct != null ? p.pct.toFixed(1) + '%' : '-', p.lng, p.xpm + '/' + p.xpa, p.pts]; }, teamCtx);
                }

                if ((ap.punting && ap.punting.length) || (hp.punting && hp.punting.length)) {
                    html += renderPlayerSection('Punting', ap.punting, hp.punting,
                        ['NO', 'YDS', 'AVG', 'LNG', 'IN20'],
                        function (p) { return [p.no, p.yds, p.avg != null ? p.avg.toFixed(1) : '-', p.lng, p.in20]; }, teamCtx);
                }
            }

            // ---- Additional info ----
            var infoParts = [];
            if (game.excitementIndex) infoParts.push(['Excitement', parseFloat(game.excitementIndex).toFixed(2)]);
            if (game.notes) infoParts.push(['Notes', game.notes]);
            if (infoParts.length) {
                html += '<div class="gd-section gd-extra">';
                for (var i = 0; i < infoParts.length; i++) {
                    html += '<div class="gd-extra-item"><span class="gd-extra-label">' + infoParts[i][0] + '</span> ' + infoParts[i][1] + '</div>';
                }
                html += '</div>';
            }

            if (isFinal) html += oddsHtml;

            container.innerHTML = html;

            // Season Leaders names get whatever width is left after the stat
            // columns; shorten only the ones that would clip. Shared with the
            // team view — see public/fit-names.js.
            if (window.ccFitNames) {
                ccFitNames('.gd-pl-name', container);
                ccWatchNameFit('.gd-pl-name', container);
            }

            // The chart's scrubbing is wired here rather than inline, because
            // the 30s live refresh replaces this container wholesale — every
            // repaint needs the handlers back on the new nodes.
            if (window.ccWpChart) ccWpChart.attach(container);

            // Same reason for the play-by-play tabs. Switching tabs repaints
            // only the list, so it costs no request and doesn't move the page.
            var pbp = container.querySelector('#gd-pbp');
            if (pbp) {
                pbp.addEventListener('click', function (e) {
                    // Collapsing a quarter is done in place rather than by
                    // repainting the list, so the reader keeps their scroll
                    // position on the quarter they were just reading.
                    var period = e.target.closest('[data-pbp-period]');
                    if (period) {
                        var open = period.getAttribute('aria-expanded') !== 'true';
                        gdPlayOpen[period.getAttribute('data-pbp-period')] = open;
                        period.setAttribute('aria-expanded', open ? 'true' : 'false');
                        var group = period.parentNode;
                        group.classList.toggle('gd-pbp-group-on', open);
                        var body = group.querySelector('.gd-pbp-period-body');
                        if (body) body.hidden = !open;
                        return;
                    }

                    var btn = e.target.closest('[data-pbp-tab]');
                    if (!btn) return;
                    var tab = btn.getAttribute('data-pbp-tab');
                    if (tab === gdPlayTab) return;
                    gdPlayTab = tab;

                    var buttons = pbp.querySelectorAll('[data-pbp-tab]');
                    for (var i = 0; i < buttons.length; i++) {
                        var on = buttons[i].getAttribute('data-pbp-tab') === gdPlayTab;
                        buttons[i].classList.toggle('gd-pbp-tab-on', on);
                        buttons[i].setAttribute('aria-selected', on ? 'true' : 'false');
                    }
                    var list = pbp.querySelector('.gd-pbp-list');
                    if (list) list.innerHTML = gdPlayList(teamCtx);
                });
            }

            // Fetched after the paint, not before it: the page is useful
            // without plays, and this request can cost a billable CFBD call.
            gdFetchPlays(game);
        }

        // ---- play-by-play ------------------------------------------------
        //
        // Two tabs over one play list: scoring plays (nine rows for a whole
        // game) and every play (~175). Both come from the same server-shaped
        // array — modules/play-by-play.js decides what counts as a scoring
        // play, so a live game and a finished one render identically.

        var gdPlays = [];            // the shaped play list, newest fetch wins
        var gdPlaysStatus = null;    // 'live' | 'final' | 'none' | 'stale' | null
        var gdPlaysDone = false;     // a final's plays never change: fetch once
        var gdPlayTab = 'scoring';   // survives the 30s re-render, unlike the DOM
        var gdPlayOpen = {};         // periodLabel -> expanded; reader choices only
        var gdDrives = [];           // shaped drive chart, from the same fetch
        var gdPlaysLive = false;     // is the game in progress? decides feed order
        var gdSituation = null;      // down/distance/possession, for the field
        var gdTeamCtx = null;        // last render's per-side context, for repaints

        function gdPlayTabs() {
            var tabs = [['scoring', 'Scoring Plays'], ['all', 'All Plays']];
            var html = '<div class="gd-pbp-tabs" role="tablist">';
            for (var i = 0; i < tabs.length; i++) {
                var on = gdPlayTab === tabs[i][0];
                html += '<button type="button" class="gd-pbp-tab' + (on ? ' gd-pbp-tab-on' : '') + '"'
                     + ' role="tab" aria-selected="' + (on ? 'true' : 'false') + '"'
                     + ' data-pbp-tab="' + tabs[i][0] + '">' + tabs[i][1] + '</button>';
            }
            return html + '</div>';
        }

        // One play card. A scoring play gets the full treatment from the
        // mockup — result heading, running score, drive line; an ordinary play
        // is a compact row, because 175 full-size cards is a wall.
        function gdPlayCard(play, teamCtx) {
            // A scoring play is attributed to whoever the points went to, which
            // is not always the team on offense — a pick-six belongs to the
            // defense, and play.teamId is the team that threw it. The server
            // works that out from the score itself; see modules/play-by-play.js.
            var attributedTo = play.scoringTeamId != null ? play.scoringTeamId : play.teamId;
            var side = attributedTo === teamCtx.home.id ? teamCtx.home
                     : (attributedTo === teamCtx.away.id ? teamCtx.away : null);
            var logo = side && side.logo
                ? '<img class="gd-pbp-logo" src="' + side.logo + '" alt="" />'
                : '<span class="gd-pbp-logo gd-pbp-logo-none"></span>';

            var clockStr = (play.clock ? play.clock : '')
                + (play.period != null ? (play.clock ? ' - ' : '') + gdOrdinal(play.period) : '');

            if (!play.scoring) {
                // CFBD sends down 1 / distance 10 on kickoffs and on the clock
                // rows (End Period, End of Half, timeouts), where there is no
                // such thing as down-and-distance. Rendering it anyway puts a
                // confident "1st & 10" next to a kickoff, so those play types
                // are suppressed rather than trusted.
                var situation = '';
                if (play.down != null && play.distance != null && gdHasDownAndDistance(play.playType)) {
                    situation = gdOrdinal(play.down) + ' & ' + play.distance;
                }
                // Pass outcomes and turnovers get a badge; a rush does not,
                // because its result is already in its own text ("for 7
                // yards") whereas complete-vs-incomplete is the thing that is
                // hard to scan for. Scores never reach here — they render as
                // cards — so 'score' is deliberately absent.
                var badge = '';
                if (play.outcome === 'complete' || play.outcome === 'incomplete'
                    || play.outcome === 'sack' || play.outcome === 'turnover') {
                    badge = '<span class="gd-pbp-badge gd-pbp-badge-' + play.outcome + '">'
                          + esc(play.outcomeLabel || '') + '</span>';
                }
                return '<div class="gd-pbp-row">'
                    + '<div class="gd-pbp-row-meta">' + logo
                    + '<span class="gd-pbp-clock">' + esc(clockStr) + '</span>'
                    + (situation ? '<span class="gd-pbp-situation">' + esc(situation) + '</span>' : '')
                    + '</div>'
                    // The badge leads the text rather than sitting in the meta
                    // column: that column is a fixed 148px so every play's text
                    // starts on the same edge, and a badge in it overflowed
                    // straight into the text.
                    + '<div class="gd-pbp-row-text">' + badge
                    + esc(play.playText || play.playType || '') + '</div>'
                    + '</div>';
            }

            return '<div class="gd-pbp-card">'
                + '<div class="gd-pbp-card-top">'
                + logo
                + '<div class="gd-pbp-card-head">'
                + '<div class="gd-pbp-result">' + esc(play.playType || 'Score') + '</div>'
                + '<div class="gd-pbp-clock">' + esc(clockStr) + '</div>'
                + '</div>'
                + '<div class="gd-pbp-score">'
                + '<div class="gd-pbp-score-col"><span class="gd-pbp-pts">' + (play.awayScore != null ? play.awayScore : '-') + '</span>'
                + '<span class="gd-pbp-abbr">' + esc(teamCtx.away.abbr) + '</span></div>'
                + '<div class="gd-pbp-score-col"><span class="gd-pbp-pts">' + (play.homeScore != null ? play.homeScore : '-') + '</span>'
                + '<span class="gd-pbp-abbr">' + esc(teamCtx.home.abbr) + '</span></div>'
                + '</div>'
                + '</div>'
                + (play.playText ? '<div class="gd-pbp-text">' + esc(play.playText) + '</div>' : '')
                + (play.driveSummary ? '<div class="gd-pbp-drive">' + esc(play.driveSummary) + '</div>' : '')
                + '</div>';
        }

        // Plays by quarter, in the order the feed introduced each period. Not
        // "insert a heading whenever the label changes": a feed that revisits a
        // period would then scatter its plays across two headings, and a
        // collapsible group has to own every play in its quarter.
        function gdPlayGroups(rows) {
            var groups = [];
            var byLabel = {};
            for (var i = 0; i < rows.length; i++) {
                var label = rows[i].periodLabel;
                if (!byLabel[label]) {
                    byLabel[label] = { label: label, plays: [] };
                    groups.push(byLabel[label]);
                }
                byLabel[label].plays.push(rows[i]);
            }
            return groups;
        }

        // Is this quarter expanded? gdPlayOpen holds only the reader's explicit
        // choices, so a quarter they've never touched follows the default —
        // newest open, everything before it closed. That also means a live game
        // reaching Q3 opens Q3 and folds Q2 away on its own, with no bookkeeping.
        function gdPeriodOpen(label, isNewest) {
            return label in gdPlayOpen ? gdPlayOpen[label] : isNewest;
        }

        // The list body. Scoring plays are nine rows for a whole game, so they
        // stay a flat list; All Plays is ~175 and collapses by quarter.
        function gdPlayList(teamCtx) {
            var rows = gdPlayTab === 'scoring'
                ? gdPlays.filter(function (p) { return p.scoring; })
                : gdPlays;

            if (!rows.length) {
                var empty;
                if (gdPlaysStatus === 'budget') {
                    empty = 'Play-by-play is paused to preserve the scoring budget.';
                } else if (gdPlaysStatus === 'none') {
                    empty = 'No plays yet.';
                } else {
                    empty = gdPlayTab === 'scoring' ? 'No scoring plays yet.' : 'No plays yet.';
                }
                return '<div class="gd-pbp-empty">' + empty + '</div>';
            }

            var groups = gdPlayGroups(rows);
            var collapsible = gdPlayTab === 'all';

            // While the game is on, the play you want is the one that just
            // happened, so the feed runs newest first — quarters reversed, and
            // the plays inside each quarter reversed with them. On a final it
            // stays chronological, because then you are reading the game rather
            // than following it.
            //
            // 'newest' is worked out BEFORE the reverse, so the collapse
            // default still opens the current quarter whichever way the list
            // is facing.
            var newestLabel = groups.length ? groups[groups.length - 1].label : null;
            if (gdPlaysLive) {
                groups = groups.slice().reverse().map(function (grp) {
                    return { label: grp.label, plays: grp.plays.slice().reverse() };
                });
            }

            var html = '';
            for (var g = 0; g < groups.length; g++) {
                var group = groups[g];
                var body = '';
                for (var i = 0; i < group.plays.length; i++) {
                    body += gdPlayCard(group.plays[i], teamCtx);
                }

                if (!collapsible) {
                    html += '<div class="gd-pbp-group">'
                         + '<h4 class="gd-pbp-period">' + esc(group.label) + '</h4>'
                         + '<div class="gd-pbp-period-body">' + body + '</div>'
                         + '</div>';
                    continue;
                }

                var open = gdPeriodOpen(group.label, group.label === newestLabel);
                var count = group.plays.length + (group.plays.length === 1 ? ' play' : ' plays');
                html += '<div class="gd-pbp-group' + (open ? ' gd-pbp-group-on' : '') + '">'
                     + '<button type="button" class="gd-pbp-period gd-pbp-period-btn"'
                     + ' data-pbp-period="' + esc(group.label) + '"'
                     + ' aria-expanded="' + (open ? 'true' : 'false') + '">'
                     + '<span class="gd-pbp-caret" aria-hidden="true"></span>'
                     + '<span class="gd-pbp-period-label">' + esc(group.label) + '</span>'
                     + '<span class="gd-pbp-period-count">' + count + '</span>'
                     + '</button>'
                     + '<div class="gd-pbp-period-body"' + (open ? '' : ' hidden') + '>' + body + '</div>'
                     + '</div>';
            }
            return html;
        }

        // ---- the field ---------------------------------------------------
        //
        // Where the ball is, which way the drive is going, and where the line
        // to gain is. Drawn only for a live game: on a final it would be a
        // picture of the last snap, which is noise.
        //
        // The possessing team ALWAYS drives left to right, with the defending
        // team's end zone on the right. CFBD's yardsToGoal is measured from the
        // offense's perspective, so this orientation makes the arithmetic one
        // subtraction and never depends on who is home — the alternative, a
        // fixed home/away orientation, has to flip the field every change of
        // possession and gets it wrong the moment `possession` is missing.
        // The geometry, worked out once and shared by the first paint and the
        // in-place update, so the two can never drift apart.
        function gdFieldState(teamCtx) {
            var sit = gdSituation;
            if (!gdPlaysLive || !sit || sit.yardsToGoal == null) return null;

            var possSide = String(sit.possession || '').toLowerCase();
            var offense = possSide === 'home' ? teamCtx.home
                        : (possSide === 'away' ? teamCtx.away : null);
            var defense = possSide === 'home' ? teamCtx.away
                        : (possSide === 'away' ? teamCtx.home : null);
            if (!offense) return null;

            // 0 = offense's own goal line, 100 = the line they are driving at.
            var ball = Math.max(0, Math.min(100, 100 - sit.yardsToGoal));
            // The line to gain, capped at the goal line — inside the distance
            // to go it does not exist, it is first-and-goal.
            var goalToGo = sit.distance != null && ball + sit.distance >= 100;
            var toGain = sit.distance != null && !goalToGo ? ball + sit.distance : null;

            var situationText = '';
            if (sit.down != null && sit.distance != null) {
                situationText = gdOrdinal(sit.down) + ' & ' + (goalToGo ? 'Goal' : sit.distance);
            }
            var spotText = sit.yardsToGoal <= 50
                ? (defense ? defense.abbr + ' ' + sit.yardsToGoal : sit.yardsToGoal + ' to go')
                : (offense.abbr + ' ' + (100 - sit.yardsToGoal));

            // The last play, in feed order. Without it a stationary ball is
            // ambiguous — an incomplete pass and a page that stopped updating
            // look identical.
            var last = gdPlays.length ? gdPlays[gdPlays.length - 1] : null;

            return {
                offense: offense, defense: defense,
                ball: ball, toGain: toGain, goalToGo: goalToGo,
                situationText: situationText, spotText: spotText,
                lastText: last ? (last.playText || last.playType || '') : '',
                lastOutcome: last ? (last.outcome || 'other') : 'other',
                lastLabel: last ? last.outcomeLabel : null,
                label: offense.name + ' ' + situationText + ' at the ' + spotText
            };
        }

        function gdFieldGraphic(teamCtx) {
            var st = gdFieldState(teamCtx);
            if (!st) return '';

            var logo = st.offense.logo
                ? '<img class="gd-lf-logo" src="' + st.offense.logo + '" alt="" />'
                : '<span class="gd-lf-logo"></span>';

            // The line to gain is always in the DOM and toggled with `hidden`,
            // not added and removed. An element that comes and goes cannot
            // transition, and first-and-goal is exactly when it would vanish.
            return '<div class="gd-section gd-lf-section" data-offense="' + esc(String(st.offense.id)) + '">'
                + '<h3 class="gd-section-title">On the Field</h3>'
                + '<div class="gd-lf-head">' + logo
                + '<span class="gd-lf-team">' + esc(st.offense.name) + '</span>'
                + '<span class="gd-lf-sit"' + (st.situationText ? '' : ' hidden') + '>'
                + esc(st.situationText) + '</span>'
                + '<span class="gd-lf-spot">' + esc(st.spotText) + '</span>'
                + '</div>'
                + '<div class="gd-lf" role="img" aria-label="' + esc(st.label) + '">'
                + '<div class="gd-lf-ez gd-lf-ez-own"><span>' + esc(st.offense.abbr) + '</span></div>'
                + '<div class="gd-lf-turf">'
                + '<div class="gd-lf-gained" style="width:' + st.ball + '%"></div>'
                + '<div class="gd-lf-togain" style="left:' + (st.toGain != null ? st.toGain : 0) + '%"'
                + (st.toGain != null ? '' : ' hidden') + '></div>'
                + '<div class="gd-lf-ball" style="left:' + st.ball + '%">'
                + '<i class="fa-solid fa-football" aria-hidden="true"></i></div>'
                + '</div>'
                + '<div class="gd-lf-ez gd-lf-ez-target"><span>'
                + esc(st.defense ? st.defense.abbr : '') + '</span></div>'
                + '</div>'
                + '<div class="gd-lf-last gd-lf-last-' + esc(st.lastOutcome) + '"'
                + (st.lastText ? '' : ' hidden') + '>'
                + '<span class="gd-lf-badge"' + (st.lastLabel ? '' : ' hidden') + '>'
                + esc(st.lastLabel || '') + '</span>'
                + '<span class="gd-lf-last-text">' + esc(st.lastText) + '</span>'
                + '</div>'
                + '</div>';
        }

        // Move the existing field rather than rebuilding it. Replacing the node
        // is what killed the ball's CSS transition: a brand-new element has no
        // previous position to animate from, so every refresh was a jump.
        //
        // Returns false when it cannot do the job in place — no field on the
        // page, or nothing to show any more — and the caller falls back to a
        // full render or removes the section.
        function gdFieldUpdate(section, teamCtx) {
            var st = gdFieldState(teamCtx);
            if (!section || !st) return false;

            var ball = section.querySelector('.gd-lf-ball');
            var gained = section.querySelector('.gd-lf-gained');
            var toGain = section.querySelector('.gd-lf-togain');
            var field = section.querySelector('.gd-lf');
            if (!ball || !gained || !toGain || !field) return false;

            // A change of possession flips which way the field points, so the
            // ball's new position is a mirror image, not a movement. Sliding
            // across the field would draw a play that never happened — so the
            // transition is suppressed for exactly that one repaint.
            var wasOffense = section.getAttribute('data-offense');
            var flipped = wasOffense !== String(st.offense.id);
            if (flipped) {
                section.setAttribute('data-offense', String(st.offense.id));
                field.classList.add('gd-lf-nosnap');
                // Read a layout property to force the class to take effect
                // before the new position is written, or the browser coalesces
                // both changes and animates anyway.
                void field.offsetWidth;
            }

            ball.style.left = st.ball + '%';
            gained.style.width = st.ball + '%';
            toGain.hidden = st.toGain == null;
            if (st.toGain != null) toGain.style.left = st.toGain + '%';
            field.setAttribute('aria-label', st.label);

            var head = section.querySelector('.gd-lf-head');
            if (head) {
                var img = head.querySelector('img.gd-lf-logo');
                if (img && st.offense.logo && img.getAttribute('src') !== st.offense.logo) {
                    img.setAttribute('src', st.offense.logo);
                }
                var team = head.querySelector('.gd-lf-team');
                if (team) team.textContent = st.offense.name;
                var sit = head.querySelector('.gd-lf-sit');
                if (sit) {
                    sit.textContent = st.situationText;
                    sit.hidden = !st.situationText;
                }
                var spot = head.querySelector('.gd-lf-spot');
                if (spot) spot.textContent = st.spotText;
            }
            var lastWrap = section.querySelector('.gd-lf-last');
            if (lastWrap) {
                lastWrap.hidden = !st.lastText;
                lastWrap.className = 'gd-lf-last gd-lf-last-' + st.lastOutcome;
                var badge = lastWrap.querySelector('.gd-lf-badge');
                if (badge) {
                    badge.textContent = st.lastLabel || '';
                    badge.hidden = !st.lastLabel;
                }
                var lastText = lastWrap.querySelector('.gd-lf-last-text');
                if (lastText) lastText.textContent = st.lastText;
            }

            var ownEz = section.querySelector('.gd-lf-ez-own span');
            if (ownEz) ownEz.textContent = st.offense.abbr;
            var targetEz = section.querySelector('.gd-lf-ez-target span');
            if (targetEz) targetEz.textContent = st.defense ? st.defense.abbr : '';

            if (flipped) {
                // Next frame, so the snap has been painted before movement is
                // allowed again.
                requestAnimationFrame(function () { field.classList.remove('gd-lf-nosnap'); });
            }
            return true;
        }

        // ---- drive chart -------------------------------------------------
        //
        // One row per drive: who had it, when it started, how far it got as a
        // bar across the field, and how it ended. The data was already being
        // fetched and persisted with the plays and thrown away.
        //
        // Newest drive first while the game is live, for the same reason the
        // play feed flips: the drive you care about is the one happening.
        function gdDriveRows(teamCtx) {
            if (!gdDrives.length) return '';
            var rows = gdPlaysLive ? gdDrives.slice().reverse() : gdDrives;
            var html = '';
            for (var i = 0; i < rows.length; i++) {
                var d = rows[i];
                var side = d.side === 'home' ? teamCtx.home
                         : (d.side === 'away' ? teamCtx.away : null);
                var logo = side && side.logo
                    ? '<img class="gd-dr-logo" src="' + side.logo + '" alt="" />'
                    : '<span class="gd-dr-logo gd-dr-logo-none"></span>';

                var start = d.fieldStart != null ? d.fieldStart : 0;
                var end = d.fieldEnd != null ? d.fieldEnd : start;
                // A drive that lost yards runs right to left, so the bar is
                // drawn from whichever end is smaller.
                var left = Math.min(start, end);
                var width = Math.max(Math.abs(end - start), 1.2);

                var when = (d.startClock ? d.startClock : '')
                    + (d.startPeriod != null ? (d.startClock ? ' · ' : '') + gdOrdinal(d.startPeriod) : '');

                html += '<div class="gd-dr gd-dr-' + d.outcome + (d.scoredAgainst ? ' gd-dr-against' : '') + '">'
                    + '<div class="gd-dr-top">' + logo
                    + '<span class="gd-dr-when">' + esc(when) + '</span>'
                    + '<span class="gd-dr-result">' + esc(d.label || d.result || '—') + '</span>'
                    + '</div>'
                    + '<div class="gd-dr-track">'
                    + '<div class="gd-dr-bar" style="left:' + left + '%;width:' + width + '%"></div>'
                    + '</div>'
                    + '<div class="gd-dr-foot">' + esc(d.summary || '') + '</div>'
                    + '</div>';
            }
            return html;
        }

        function renderDrivesSection(teamCtx) {
            if (!gdDrives.length) return '';
            return '<div class="gd-section gd-dr-section">'
                + '<h3 class="gd-section-title">Drives</h3>'
                + '<div class="gd-dr-list">' + gdDriveRows(teamCtx) + '</div>'
                + '</div>';
        }

        function renderPlaysSection(teamCtx) {
            // Nothing fetched yet, and nothing to say — the section appears on
            // the tick after the plays arrive rather than flashing an empty
            // shell on first paint.
            if (!gdPlays.length && gdPlaysStatus == null) return '';

            return '<div class="gd-section gd-pbp" id="gd-pbp">'
                + '<h3 class="gd-section-title">Play-by-Play</h3>'
                + gdPlayTabs()
                + '<div class="gd-pbp-list">' + gdPlayList(teamCtx) + '</div>'
                + '</div>';
        }

        // Is this a scrimmage play, i.e. one where down-and-distance means
        // something? Matched on prefix so 'Kickoff Return (Offense)' is caught
        // alongside 'Kickoff'.
        var GD_NO_DOWN_TYPES = ['Kickoff', 'End ', 'Timeout'];
        function gdHasDownAndDistance(playType) {
            if (!playType) return false;
            for (var i = 0; i < GD_NO_DOWN_TYPES.length; i++) {
                if (playType.indexOf(GD_NO_DOWN_TYPES[i]) === 0) return false;
            }
            return true;
        }

        // 1st / 2nd / 3rd / 4th, and OT past regulation.
        function gdOrdinal(n) {
            if (n == null) return '';
            if (n === 1) return '1st';
            if (n === 2) return '2nd';
            if (n === 3) return '3rd';
            if (n === 4) return '4th';
            if (n > 4) return n === 5 ? 'OT' : (n - 4) + 'OT';
            return String(n);
        }

        function renderPlayerSection(title, awayPlayers, homePlayers, cols, extractFn, teamCtx) {
            awayPlayers = awayPlayers || [];
            homePlayers = homePlayers || [];
            if (!awayPlayers.length && !homePlayers.length) return '';

            var html = '<div class="gd-section">';
            html += '<h3 class="gd-section-title">' + title + '</h3>';
            html += '<div class="gd-player-tables">';

            html += playerTable(awayPlayers, cols, extractFn, teamCtx.away);
            html += playerTable(homePlayers, cols, extractFn, teamCtx.home);

            html += '</div></div>';
            return html;
        }

        function playerTable(players, cols, extractFn, team) {
            if (!players || !players.length) return '<div class="gd-player-table gd-player-empty">No stats</div>';
            var html = '<div class="gd-player-table" style="border-top: 3px solid ' + team.color + '">';
            html += '<div class="gd-pt-header"><img class="gd-pt-logo" src="' + team.logo + '" alt="" /> ' + team.name + '</div>';
            html += '<div class="gd-table-scroll"><table>';
            html += '<thead><tr><th class="gd-player-name">Player</th>';
            for (var c = 0; c < cols.length; c++) html += '<th>' + cols[c] + '</th>';
            html += '</tr></thead><tbody>';
            for (var i = 0; i < players.length; i++) {
                var vals = extractFn(players[i]);
                html += '<tr><td class="gd-player-name">' + players[i].name + '</td>';
                for (var c = 0; c < vals.length; c++) html += '<td>' + fmt(vals[c]) + '</td>';
                html += '</tr>';
            }
            html += '</tbody></table></div></div>';
            return html;
        }

        load();
    })();
    </script>
</body>
</html>
