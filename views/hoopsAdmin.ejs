<!DOCTYPE html>
<html lang="en" data-sport="basketball">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <!-- Absolute paths: this page lives one level down (/hoops/admin). -->
    <link href="/styles.css" rel="stylesheet">
    <link href="/sport-page.css" rel="stylesheet">
    <link href="/admin.css" rel="stylesheet">
    <link href="/hoopsAdmin.css" rel="stylesheet">
    <link href="/admin-clipboard.css" rel="stylesheet">
    <script src="/haptic.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Graduate&family=Pacifico&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet"/>
    <script defer src="/sport-page.js"></script>
    <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
    <%# Platform-wide basketball data. A league's commissioner (#600) gets
        League setup only, as a League Manager does on football's /admin. %>
    <script defer src="/hoopsAdmin.js"></script>
    <script defer src="/hoopsPreseason.js"></script>
    <% } %>
    <% if (manageLeague) { %>
    <!-- League setup is football's admin code, pointed at this league. -->
    <script defer src="/admin.js"></script>
    <%# The Clipboard rides on admin.js (openTool, the setup openers), so it
        is here only when League setup is. %>
    <script defer src="/admin-clipboard.js"></script>
    <script defer src="/admin-clipboard-view.js"></script>
    <% } %>
    <title><%= (typeof isAdmin !== 'undefined' && isAdmin) ? 'Basketball Admin' : 'League Management' %> · Campus Clash</title>
    <%- include('partials/favicons') %>
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#101322" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
</head>
<body>
    <%- include('partials/navbar') %>
    <% if (userState) { %>
        <script>
            var userState = <%- userState %>;
        </script>
    <% } %>
    <script>
        // What admin.js manages on this page: the basketball league and ITS
        // season — never the viewed league, which may be football, and never
        // football's season.
        window.ADMIN_SPORT = 'basketball';
        window.ADMIN_LEAGUE = <%- JSON.stringify(manageLeague || null).replace(/</g, '\\u003c') %>;
        window.APP_YEAR = "<%= year %>";
        window.DRAFT_DEFAULTS = <%- draftDefaults %>;
        // The Clipboard's role split: the basketball data rows and tasks are
        // an Admin's alone (/hoops/admin/status 404s for anyone else).
        window.ADMIN_IS_ADMIN = <%= (typeof isAdmin !== 'undefined' && isAdmin) ? 'true' : 'false' %>;
    </script>
    <%# Every league, both sports, and Create league (#536) — for an Admin,
        and for a League Manager, who may create one (#600). %>
    <% if (typeof canCreateLeague !== 'undefined' && canCreateLeague) { %>
    <nav class="admin-leagues-link"><a href="/leagues"><i class="fa-solid fa-layer-group" aria-hidden="true"></i> Leagues</a></nav>
    <% } %>
    <% var _admin = typeof isAdmin !== 'undefined' && isAdmin; %>
    <% if (manageLeague) { %>
    <%# With a league to manage: the Clipboard on top, the league's roster,
        then every tool in one Toolbox drawer — the same frame as football's
        /admin (#606/#607). %>
    <div class="header"><div class="header-title" role="heading" aria-level="1"><%= _admin ? 'Basketball Admin' : 'League Management' %></div></div>
    <section class="cb-wrap" admin-clipboard hidden aria-label="Season checklist"></section>
    <div class="ha-league ha-league-top">
        <h2 class="ha-league-h"><%= manageLeagueName %> <small><%= year %></small></h2>
        <div class="get-users-container" get-users-container>
            <div class="table-wrapper">
                <table class="fl-table">
                    <thead><tr><th>Name</th><th>Teams</th></tr></thead>
                    <tbody user-table-body></tbody>
                </table>
            </div>
        </div>
    </div>
    <details class="cb-toolbox" admin-toolbox>
        <summary><i class="fa-solid fa-toolbox" aria-hidden="true"></i><span class="cb-toolbox-name">Toolbox</span><span class="cb-toolbox-meta" admin-toolbox-meta></span><i class="fa-solid fa-chevron-down cb-toolbox-caret" aria-hidden="true"></i></summary>
        <%# Automated jobs: the same list on both sports' pages, filled by
            public/admin-clipboard-view.js from the Clipboard model's JOBS. %>
        <section class="cb-jobs" admin-jobs data-toolbox-group="Automated jobs" tabindex="-1" aria-labelledby="cb-jobs-h">
            <h3 class="cb-jobs-h" id="cb-jobs-h">Automated jobs <span admin-jobs-count></span></h3>
            <ul class="cb-jobs-list" admin-jobs-list><li class="cb-job-none">Loading…</li></ul>
        </section>
        <% if (_admin) { %>
        <main class="sp-page ha" id="hoops-admin" data-toolbox-group="Basketball data">
            <div class="sp-loading">Loading…</div>
        </main>
        <%# Its own container: <main> is redrawn whole on every update, which
            would wipe a paste (#544). %>
        <section class="sp-page ha" id="hoops-preseason" data-toolbox-group="Preseason ratings"></section>
        <% } %>
        <div class="ha-league">
            <%- include('partials/admin-league-setup', { sport: 'basketball' }) %>
        </div>
    </details>
    <% } else if (_admin) { %>
    <%# An Admin with no basketball league yet: the data tasks only, open —
        there is no checklist to put above a drawer. %>
    <main class="sp-page ha" id="hoops-admin">
        <div class="sp-loading">Loading…</div>
    </main>
    <section class="sp-page ha" id="hoops-preseason"></section>
    <% } %>
</body>
</html>
